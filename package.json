{
  "name": "computer-use-automation",
  "version": "0.1.0",
  "description": "Computer-use automation system for bank back-office applications — LLM discovery, deterministic replay, human-in-the-loop escalation.",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "cua": "src/cli/index.ts"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "mock-app": "tsx mock-app/server.ts",
    "build": "tsc",
    "discover": "tsx src/cli/index.ts discover",
    "replay": "tsx src/cli/index.ts replay",
    "escalate": "tsx src/cli/index.ts escalate"
  },
  "keywords": ["computer-use", "automation", "playwright", "banking"],
  "author": "Ismail Kuraydli",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/express": "^4.17.21",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  },
  "dependencies": {
    "express": "^4.21.0",
    "playwright": "^1.48.0"
  }
}
