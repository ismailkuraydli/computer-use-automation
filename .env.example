# Copy to .env. Only OPENROUTER_API_KEY is needed, and only for discovery
# (replay never calls a model). The model is set in cua.config.json.
OPENROUTER_API_KEY=

# Optional: where the application runs. Replays are rebased onto it and
# discovery starts there (same as the plugin setting target_url / CLI --base-url).
CUA_TARGET_URL=

# Optional: where artifacts and evidence are written (default: current directory).
CUA_WORKSPACE=
