# LLM API Keys
# OpenRouter — primary provider (supports Claude, Gemini, GPT-4o, etc.)
OPENROUTER_API_KEY=

# Direct provider keys (optional — use if you bypass OpenRouter)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=

# Mock app
MOCK_APP_PORT=3000

# CUA system
# Override the config file location (default: ./cua.config.json)
CUA_CONFIG_PATH=
